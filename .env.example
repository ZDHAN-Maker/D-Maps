# D'Maps Environment Configuration

# Optional external Object Storage (Cloudflare R2, AWS S3, MinIO, or CDN) for nationwide datasets
# e.g.: VITE_STORAGE_BASE_URL=https://pub-xxxxxx.r2.dev/dmaps
# If omitted or empty, datasets default to local /data/<id> (e.g. Jambi and Monaco fixtures).
VITE_STORAGE_BASE_URL=
